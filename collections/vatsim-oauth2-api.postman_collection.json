                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Authorization code returned in the callback from the server\n\nRequired when using the `authorization_code` grant"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "0%20<string>%201%20<string>",
