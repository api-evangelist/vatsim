          "name": "Request an access token",
          "request": {
            "name": "Request an access token",
            "description": {
              "content": "Returns an access token for the end user",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Which grant type to use\n\n`authorization_code` and `refresh_token` are used by most clients\n\n`password` is only available with prior approval from VATSIM"
                },
